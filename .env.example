# ─── Skybite production env — скопируй в .env и заполни секреты ───
# Settings (pydantic-settings) читает переменные окружения; реальные env-переменные
# имеют приоритет над .env.dev. На сервере значения подаются через systemd
# EnvironmentFile=/opt/skybite/.env (см. infra/skybite.service).

ENV=prod
SYSTEM_MODE=test               # test | preflight | full
MQTT_URL=mqtt://127.0.0.1:1883
REPO_IMPL=mem                  # in-memory репозитории — Postgres НЕ требуется

# ─── ОБЯЗАТЕЛЬНО заменить (иначе кто угодно зайдёт и сможет командовать бортом) ───
# Сгенерировать секрет:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=__CHANGE_ME__paste_48+_random_chars_here__
# Код входа оператора (раздаётся операторам):
ACCESS_CODE=__CHANGE_ME__operator_login_code__

# За HTTPS обязательно true — иначе cookie сессии не будет помечена Secure:
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
CONTROL_TTL_SEC=25
